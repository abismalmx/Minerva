# Minerva — configuracion local de la app
#
# Copia este archivo a `apps/minerva-app/.env.local` (Next.js lo carga solo).
# Para un despliegue propio basta con lo de la seccion "Servidor".
# Ningun valor real se versiona.

# --- Servidor (tu backend autoalojado) -------------------------------------
# Origen de tu Cloudflare Worker. La app le anade `/api` por su cuenta.
NEXT_PUBLIC_API_BASE_URL=https://minerva-cloudflare.<tu-subdominio>.workers.dev

# Autentica contra tu Worker en lugar de contra Minerva Cloud: te registras
# con email + passphrase y el trafico no sale de tu cuenta de Cloudflare.
SELF_HOSTED_BACKEND=true
NEXT_PUBLIC_SELF_HOSTED_BACKEND=true

# Desbloquea las funciones de pago: en un despliegue propio no hay tienda.
SELF_HOSTED=true
NEXT_PUBLIC_SELF_HOSTED=true

# Passphrase de sincronizacion. Cifra en el cliente los campos sensibles que
# se suben; el servidor solo guarda la sal. Si la dejas vacia hay que
# escribirla en cada dispositivo (Ajustes → Sincronizacion).
SYNC_PASSPHRASE=

# --- Opcionales -------------------------------------------------------------
# Telemetría (PostHog). Vacia = sin telemetría.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Cuota de almacenamiento por cuenta, en bytes (0 = sin cuota).
NEXT_PUBLIC_STORAGE_FIXED_QUOTA=

# Catalogo de TTS en linea (deja la URL de tu servidor si alojas el catalogo).
MINERVA_TTS_CATALOG_URL=
