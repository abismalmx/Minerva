# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
.test-sandbox-node/
.vitest-attachments/

# benchmarks — personal local perf history; share via PR/issue copy-paste
bench/results.jsonl

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# certs and keys
/private_keys
# TLS certs that `next dev --experimental-https` generates with mkcert
/certificates

# plists
Entitlements*.plist

# local confs
tauri.*.conf.json
# tracked exceptions: the direct-distribution overlay, the unsigned variant
# (no Apple-issued provisioning profile) and the CI overlay (no updater
# artifacts) ship in the repo
!tauri.macos-nonestore.conf.json
!tauri.macos-unsigned.conf.json
!tauri.ci.conf.json

# vercel
.vercel

# open-next
.open-next
.wrangler

# typescript
*.tsbuildinfo
next-env.d.ts

# eslint
.eslintcache

#generated
# The Android Studio project IS tracked: it carries the FOSS/pen flavors, the
# `keystore.properties` signing config and the llvm-strip step, none of which
# the Tauri CLI template has. `tauri android init` only fills in files that do
# not exist yet, so a tracked project survives it, and CI restores it with
# `git checkout .` after regenerating it. Everything else under `gen/` is CLI
# output and stays ignored.
src-tauri/gen/*
!src-tauri/gen/android/

# local dev overrides (personal signing, etc.)
src-tauri/tauri.*.local.json

# vendor: only what the reader fetches by URL at runtime. Modules the bundler
# imports resolve straight from packages/ (see vendor-aliases-outside-public.test.ts).
/public/vendor

# docs
docs/superpowers

# Auto Generated PWA files
/public/sw.js
/public/workbox-*.js
/public/fallback-*.js
/public/swe-worker-*.js

/dist/

.context/
.claude/settings.local.json
.claude/skills
.claude/plans

# Playwright web e2e
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/


# Word Lens build-input corpora (ECDICT, WikDict, FrequencyWords, etc.) — large,
# downloaded on demand by scripts/build-wordlens-data.mjs; cached locally, not committed.
/data/wordlens/.sources/
