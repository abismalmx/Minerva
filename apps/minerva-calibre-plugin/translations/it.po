msgid "Push selected books and their metadata into your Minerva cloud library. Re-pushing a book updates its existing entry instead of creating a duplicate."
msgstr "Invia i libri selezionati e i relativi metadati alla tua libreria cloud Minerva. Reinviando un libro si aggiorna la voce esistente invece di crearne un duplicato."

msgid "Not logged in."
msgstr "Accesso non effettuato."

msgid "Include custom columns in pushed metadata"
msgstr "Includi colonne personalizzate nei metadati inviati"

msgid "Only change this if you run a self-hosted Minerva server."
msgstr "Modifica questo solo se usi un server Minerva auto-ospitato."

msgid "Logged in as %s."
msgstr "Accesso effettuato come %s."

msgid "API server:"
msgstr "Server API:"

msgid "Use the Minerva toolbar menu to log in or out."
msgstr "Usa il menu Minerva della barra degli strumenti per accedere o uscire."

msgid "Push to Minerva"
msgstr "Invia a Minerva"

msgid "Push to Minerva failed"
msgstr "Invio a Minerva non riuscito"

msgid "Minerva status"
msgstr "Stato di Minerva"

msgid "Minerva status check failed"
msgstr "Controllo dello stato di Minerva non riuscito"

msgid "Log in to Minerva"
msgstr "Accedi a Minerva"

msgid "Email:"
msgstr "E-mail:"

msgid "Password:"
msgstr "Password:"

msgid "Log in"
msgstr "Accedi"

msgid "Logging in…"
msgstr "Accesso in corso…"

msgid "Waiting for the browser login to complete…"
msgstr "Attesa del completamento dell'accesso nel browser…"

msgid "Unknown"
msgstr "Sconosciuto"

msgid "Pushing %d book to your Minerva library…"
msgid_plural "Pushing %d books to your Minerva library…"
msgstr[0] "Invio di %d libro alla tua libreria Minerva…"
msgstr[1] "Invio di %d libri alla tua libreria Minerva…"

msgid "Checking %d book against your Minerva library…"
msgid_plural "Checking %d books against your Minerva library…"
msgstr[0] "Controllo di %d libro nella tua libreria Minerva…"
msgstr[1] "Controllo di %d libri nella tua libreria Minerva…"

msgid "Or sign in with your browser:"
msgstr "Oppure accedi con il browser:"

msgid "Please enter both email and password."
msgstr "Inserisci sia l'e-mail che la password."

msgid "Login failed: the browser callback carried no session."
msgstr "Accesso non riuscito: la risposta del browser non conteneva alcuna sessione."

msgid "Book"
msgstr "Libro"

msgid "Status"
msgstr "Stato"

msgid "Details"
msgstr "Dettagli"

msgid "Canceling…"
msgstr "Annullamento…"

msgid "Browser login timed out. Try again."
msgstr "Accesso tramite browser scaduto. Riprova."

msgid "Login failed: %s"
msgstr "Accesso non riuscito: %s"

msgid "Minerva Login"
msgstr "Accesso a Minerva"

msgid "Completing login…"
msgstr "Completamento dell'accesso…"

msgid "Login complete. You can close this tab and return to calibre."
msgstr "Accesso completato. Puoi chiudere questa scheda e tornare a calibre."

msgid "Minerva"
msgstr "Minerva"

msgid "Push selected books and metadata to your Minerva library"
msgstr "Invia i libri selezionati e i metadati alla tua libreria Minerva"

msgid "Select the books to push to Minerva."
msgstr "Seleziona i libri da inviare a Minerva."

msgid "Select the books to check against Minerva."
msgstr "Seleziona i libri da controllare su Minerva."

msgid "No books selected"
msgstr "Nessun libro selezionato"

msgid "Push selected books to Minerva"
msgstr "Invia i libri selezionati a Minerva"

msgid "Check Minerva status"
msgstr "Controlla lo stato di Minerva"

msgid "Log in to Minerva…"
msgstr "Accedi a Minerva…"

msgid "Log out"
msgstr "Esci"

msgid "Customize plugin…"
msgstr "Personalizza il plugin…"

msgid "Log out (%s)"
msgstr "Esci (%s)"

msgid "your Minerva account"
msgstr "il tuo account Minerva"

msgid "Uploaded"
msgstr "Caricato"

msgid "Replaced"
msgstr "Sostituito"

msgid "Updated"
msgstr "Aggiornato"

msgid "Up to date"
msgstr "Già aggiornato"

msgid "Failed"
msgstr "Non riuscito"

msgid "In Minerva"
msgstr "In Minerva"

msgid "Metadata differs"
msgstr "Metadati diversi"

msgid "Out of date"
msgstr "Obsoleto"

msgid "Not in Minerva"
msgstr "Non in Minerva"

msgid "No Minerva-supported format (EPUB, PDF, ...)"
msgstr "Nessun formato supportato da Minerva (EPUB, PDF, ...)"

msgid "Book file is missing from the calibre library"
msgstr "Il file del libro è assente dalla libreria di calibre"

msgid "Nothing to push."
msgstr "Nulla da inviare."

msgid "Nothing to check."
msgstr "Nulla da controllare."

msgid "Please log in to Minerva first. (%s)"
msgstr "Accedi prima a Minerva. (%s)"

msgid "Could not reach Minerva: %s"
msgstr "Impossibile raggiungere Minerva: %s"

msgid "Canceled."
msgstr "Annullato."

msgid "Minerva storage quota exceeded — push stopped."
msgstr "Quota di archiviazione Minerva superata — invio interrotto."

msgid "Session expired — please log in again."
msgstr "Sessione scaduta — accedi di nuovo."

msgid "Login failed"
msgstr "Accesso non riuscito"

msgid "Not logged in"
msgstr "Accesso non effettuato"

msgid "Session expired, please log in again"
msgstr "Sessione scaduta, accedi di nuovo"

msgid "Not authenticated"
msgstr "Non autenticato"

msgid "Request failed (%s)"
msgstr "Richiesta non riuscita (%s)"

msgid "Upload failed (%s)"
msgstr "Caricamento non riuscito (%s)"

