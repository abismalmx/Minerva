#: __init__.py:16
msgid "Push selected books and their metadata into your Minerva cloud library. Re-pushing a book updates its existing entry instead of creating a duplicate."
msgstr "선택한 책과 메타데이터를 Minerva 클라우드 라이브러리로 푸시합니다. 같은 책을 다시 푸시하면 중복 항목을 만들지 않고 기존 항목을 업데이트합니다."

#: config.py:36
msgid "Not logged in."
msgstr "로그인하지 않았습니다."

#: config.py:42
msgid "Include custom columns in pushed metadata"
msgstr "푸시하는 메타데이터에 사용자 지정 열 포함"

#: config.py:51
msgid "Only change this if you run a self-hosted Minerva server."
msgstr "자체 호스팅 Minerva 서버를 운영하는 경우에만 변경하세요."

#: config.py:36 ui.py:136
msgid "Logged in as %s."
msgstr "%s으로 로그인했습니다."

#: config.py:47
msgid "API server:"
msgstr "API 서버:"

#: config.py:38
msgid "Use the Minerva toolbar menu to log in or out."
msgstr "로그인하거나 로그아웃하려면 Minerva 도구 모음 메뉴를 사용하세요."

