msgid "Push selected books and their metadata into your Minerva cloud library. Re-pushing a book updates its existing entry instead of creating a duplicate."
msgstr "Envie os livros selecionados e seus metadados para sua biblioteca na nuvem Minerva. Reenviar um livro atualiza a entrada existente em vez de criar uma duplicata."

msgid "Not logged in."
msgstr "Não conectado."

msgid "Include custom columns in pushed metadata"
msgstr "Incluir colunas personalizadas nos metadados enviados"

msgid "Only change this if you run a self-hosted Minerva server."
msgstr "Altere isto somente se você executar um servidor Minerva auto-hospedado."

msgid "Logged in as %s."
msgstr "Conectado como %s."

msgid "API server:"
msgstr "Servidor de API:"

msgid "Use the Minerva toolbar menu to log in or out."
msgstr "Use o menu Minerva da barra de ferramentas para entrar ou sair."

msgid "Push to Minerva"
msgstr "Enviar para o Minerva"

msgid "Push to Minerva failed"
msgstr "Falha ao enviar para o Minerva"

msgid "Minerva status"
msgstr "Situação do Minerva"

msgid "Minerva status check failed"
msgstr "Falha na verificação da situação do Minerva"

msgid "Log in to Minerva"
msgstr "Entrar no Minerva"

msgid "Email:"
msgstr "E-mail:"

msgid "Password:"
msgstr "Senha:"

msgid "Log in"
msgstr "Entrar"

msgid "Logging in…"
msgstr "Entrando…"

msgid "Waiting for the browser login to complete…"
msgstr "Aguardando a conclusão do login no navegador…"

msgid "Unknown"
msgstr "Desconhecido"

msgid "Pushing %d book to your Minerva library…"
msgid_plural "Pushing %d books to your Minerva library…"
msgstr[0] "Enviando %d livro para sua biblioteca Minerva…"
msgstr[1] "Enviando %d livros para sua biblioteca Minerva…"

msgid "Checking %d book against your Minerva library…"
msgid_plural "Checking %d books against your Minerva library…"
msgstr[0] "Verificando %d livro na sua biblioteca Minerva…"
msgstr[1] "Verificando %d livros na sua biblioteca Minerva…"

msgid "Or sign in with your browser:"
msgstr "Ou entre com seu navegador:"

msgid "Please enter both email and password."
msgstr "Informe o e-mail e a senha."

msgid "Login failed: the browser callback carried no session."
msgstr "Falha no login: o retorno do navegador não trouxe nenhuma sessão."

msgid "Book"
msgstr "Livro"

msgid "Status"
msgstr "Situação"

msgid "Details"
msgstr "Detalhes"

msgid "Canceling…"
msgstr "Cancelando…"

msgid "Browser login timed out. Try again."
msgstr "O login no navegador expirou. Tente novamente."

msgid "Login failed: %s"
msgstr "Falha no login: %s"

msgid "Minerva Login"
msgstr "Entrar no Minerva"

msgid "Completing login…"
msgstr "Concluindo o login…"

msgid "Login complete. You can close this tab and return to calibre."
msgstr "Login concluído. Você pode fechar esta aba e voltar ao calibre."

msgid "Minerva"
msgstr "Minerva"

msgid "Push selected books and metadata to your Minerva library"
msgstr "Enviar os livros selecionados e metadados para sua biblioteca Minerva"

msgid "Select the books to push to Minerva."
msgstr "Selecione os livros a enviar para o Minerva."

msgid "Select the books to check against Minerva."
msgstr "Selecione os livros a verificar no Minerva."

msgid "No books selected"
msgstr "Nenhum livro selecionado"

msgid "Push selected books to Minerva"
msgstr "Enviar os livros selecionados para o Minerva"

msgid "Check Minerva status"
msgstr "Verificar a situação do Minerva"

msgid "Log in to Minerva…"
msgstr "Entrar no Minerva…"

msgid "Log out"
msgstr "Sair"

msgid "Customize plugin…"
msgstr "Personalizar o plugin…"

msgid "Log out (%s)"
msgstr "Sair (%s)"

msgid "your Minerva account"
msgstr "sua conta Minerva"

msgid "Uploaded"
msgstr "Enviado"

msgid "Replaced"
msgstr "Substituído"

msgid "Updated"
msgstr "Atualizado"

msgid "Up to date"
msgstr "Em dia"

