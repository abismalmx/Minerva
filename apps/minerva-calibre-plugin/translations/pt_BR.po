msgstr "Falhou"

msgid "In Minerva"
msgstr "No Minerva"

msgid "Metadata differs"
msgstr "Metadados diferentes"

msgid "Out of date"
msgstr "Desatualizado"

msgid "Not in Minerva"
msgstr "Não está no Minerva"

msgid "No Minerva-supported format (EPUB, PDF, ...)"
msgstr "Nenhum formato suportado pelo Minerva (EPUB, PDF, ...)"

msgid "Book file is missing from the calibre library"
msgstr "O arquivo do livro está ausente na biblioteca do calibre"

msgid "Nothing to push."
msgstr "Nada para enviar."

msgid "Nothing to check."
msgstr "Nada para verificar."

msgid "Please log in to Minerva first. (%s)"
msgstr "Entre no Minerva primeiro. (%s)"

msgid "Could not reach Minerva: %s"
msgstr "Não foi possível alcançar o Minerva: %s"

msgid "Canceled."
msgstr "Cancelado."

msgid "Minerva storage quota exceeded — push stopped."
