msgid "Login failed"
msgstr "Falha no login"

msgid "Not logged in"
msgstr "Não conectado"

msgid "Session expired, please log in again"
msgstr "Sessão expirada, entre novamente"

msgid "Not authenticated"
msgstr "Não autenticado"

msgid "Request failed (%s)"
msgstr "Falha na solicitação (%s)"

msgid "Upload failed (%s)"
msgstr "Falha no envio (%s)"

