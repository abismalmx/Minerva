msgid_plural "%d uploaded"
msgstr[0] "%d enviado"
msgstr[1] "%d enviados"

msgid "%d replaced"
msgid_plural "%d replaced"
msgstr[0] "%d substituído"
msgstr[1] "%d substituídos"

msgid "%d updated"
msgid_plural "%d updated"
msgstr[0] "%d atualizado"
msgstr[1] "%d atualizados"

