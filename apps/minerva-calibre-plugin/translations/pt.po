msgid "Push selected books and their metadata into your Minerva cloud library. Re-pushing a book updates its existing entry instead of creating a duplicate."
msgstr "Envie os livros selecionados e os seus metadados para a sua biblioteca na nuvem Minerva. Reenviar um livro atualiza a entrada existente em vez de criar uma duplicada."

msgid "Not logged in."
msgstr "Sessão não iniciada."

msgid "Include custom columns in pushed metadata"
msgstr "Incluir colunas personalizadas nos metadados enviados"

msgid "Only change this if you run a self-hosted Minerva server."
msgstr "Altere isto apenas se executar um servidor Minerva autoalojado."

msgid "Logged in as %s."
msgstr "Sessão iniciada como %s."

msgid "API server:"
msgstr "Servidor de API:"

msgid "Use the Minerva toolbar menu to log in or out."
msgstr "Use o menu Minerva da barra de ferramentas para iniciar ou terminar sessão."

msgid "Push to Minerva"
msgstr "Enviar para o Minerva"

msgid "Push to Minerva failed"
msgstr "Falha ao enviar para o Minerva"

msgid "Minerva status"
msgstr "Estado do Minerva"

msgid "Minerva status check failed"
msgstr "Falha na verificação do estado do Minerva"

msgid "Log in to Minerva"
msgstr "Iniciar sessão no Minerva"

msgid "Email:"
msgstr "E-mail:"

msgid "Password:"
msgstr "Palavra-passe:"

msgid "Log in"
msgstr "Iniciar sessão"

msgid "Logging in…"
msgstr "A iniciar sessão…"

msgid "Waiting for the browser login to complete…"
msgstr "A aguardar a conclusão do início de sessão no navegador…"

msgid "Unknown"
msgstr "Desconhecido"

msgid "Pushing %d book to your Minerva library…"
msgid_plural "Pushing %d books to your Minerva library…"
msgstr[0] "A enviar %d livro para a sua biblioteca Minerva…"
msgstr[1] "A enviar %d livros para a sua biblioteca Minerva…"

msgid "Checking %d book against your Minerva library…"
msgid_plural "Checking %d books against your Minerva library…"
msgstr[0] "A verificar %d livro na sua biblioteca Minerva…"
msgstr[1] "A verificar %d livros na sua biblioteca Minerva…"

msgid "Or sign in with your browser:"
msgstr "Ou inicie sessão com o seu navegador:"

msgid "Please enter both email and password."
msgstr "Introduza o e-mail e a palavra-passe."

msgid "Login failed: the browser callback carried no session."
msgstr "Falha ao iniciar sessão: a resposta do navegador não trouxe nenhuma sessão."

msgid "Book"
msgstr "Livro"

msgid "Status"
msgstr "Estado"

msgid "Details"
msgstr "Detalhes"

msgid "Canceling…"
msgstr "A cancelar…"

msgid "Browser login timed out. Try again."
msgstr "O início de sessão no navegador expirou. Tente novamente."

msgid "Login failed: %s"
msgstr "Falha ao iniciar sessão: %s"

msgid "Minerva Login"
msgstr "Início de sessão no Minerva"

msgid "Completing login…"
msgstr "A concluir o início de sessão…"

msgid "Login complete. You can close this tab and return to calibre."
msgstr "Início de sessão concluído. Pode fechar este separador e voltar ao calibre."

msgid "Minerva"
msgstr "Minerva"

msgid "Push selected books and metadata to your Minerva library"
msgstr "Enviar os livros selecionados e os metadados para a sua biblioteca Minerva"

msgid "Select the books to push to Minerva."
msgstr "Selecione os livros a enviar para o Minerva."

msgid "Select the books to check against Minerva."
msgstr "Selecione os livros a verificar no Minerva."

msgid "No books selected"
msgstr "Nenhum livro selecionado"

msgid "Push selected books to Minerva"
msgstr "Enviar os livros selecionados para o Minerva"

msgid "Check Minerva status"
msgstr "Verificar o estado do Minerva"

msgid "Log in to Minerva…"
msgstr "Iniciar sessão no Minerva…"

msgid "Log out"
msgstr "Terminar sessão"

msgid "Customize plugin…"
msgstr "Personalizar o plugin…"

msgid "Log out (%s)"
msgstr "Terminar sessão (%s)"

msgid "your Minerva account"
msgstr "a sua conta Minerva"

msgid "Uploaded"
msgstr "Enviado"

msgid "Replaced"
msgstr "Substituído"

msgid "Updated"
msgstr "Atualizado"

msgid "Up to date"
msgstr "Em dia"

msgid "Failed"
msgstr "Falhou"

msgid "In Minerva"
msgstr "No Minerva"

msgid "Metadata differs"
msgstr "Metadados diferentes"

msgid "Out of date"
msgstr "Desatualizado"

msgid "Not in Minerva"
msgstr "Não está no Minerva"

msgid "No Minerva-supported format (EPUB, PDF, ...)"
msgstr "Nenhum formato suportado pelo Minerva (EPUB, PDF, ...)"

msgid "Book file is missing from the calibre library"
msgstr "O ficheiro do livro não está na biblioteca do calibre"

msgid "Nothing to push."
msgstr "Nada para enviar."

msgid "Nothing to check."
msgstr "Nada para verificar."

msgid "Please log in to Minerva first. (%s)"
msgstr "Inicie sessão no Minerva primeiro. (%s)"

msgid "Could not reach Minerva: %s"
msgstr "Não foi possível contactar o Minerva: %s"

msgid "Canceled."
msgstr "Cancelado."

msgid "Minerva storage quota exceeded — push stopped."
msgstr "Quota de armazenamento do Minerva excedida — envio interrompido."

msgid "Session expired — please log in again."
msgstr "Sessão expirada — inicie sessão novamente."

msgid "Login failed"
msgstr "Falha ao iniciar sessão"

msgid "Not logged in"
msgstr "Sessão não iniciada"

msgid "Session expired, please log in again"
msgstr "Sessão expirada, inicie sessão novamente"

msgid "Not authenticated"
msgstr "Não autenticado"

msgid "Request failed (%s)"
msgstr "O pedido falhou (%s)"

msgid "Upload failed (%s)"
msgstr "O envio falhou (%s)"

