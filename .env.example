# Minerva — backend autoalojado en Cloudflare
#
# Este repositorio existe para montar TU servidor de sincronizacion: un
# Cloudflare Worker (apps/minerva-app/workers/minerva-sync) con D1 (SQLite)
# y R2 (los libros). No hay nada de esto es obligatorio para compilar: el
# script ./deploy-cloudflare.sh crea los recursos, genera el secreto y
# publica el Worker por su cuenta.
#
# Copia este archivo a `apps/minerva-app/.env` (Next.js lo carga solo) y
# rellena lo que necesites. Ningun valor real se versiona.

# --- Despliegue en Cloudflare ----------------------------------------------
# ID de tu cuenta de Cloudflare. Lo usa `wrangler` para saber a quien
# pertenece el despliegue; `npx wrangler whoami` te lo muestra.
CF_ACCOUNT_ID=

# Nombre del bucket R2 donde se guardan los libros, las portadas y los blobs
# de las réplicas. El script lo crea si no existe.
CF_R2_BUCKET=minerva-library

# ID de la base de datos D1 (SQLite) con las cuentas, la biblioteca, las
# notas y las réplicas. `wrangler d1 create minerva-sync` lo imprime.
CF_D1_DATABASE_ID=

# Secreto de firma del Worker: con el emite sus propios tokens (HS256) y las
# URLs firmadas de descarga. 32+ caracteres aleatorios.
# NO se escribe en wrangler.toml: se registra en Cloudflare Secrets con
#   npx wrangler secret put JWT_SECRET
# y `./deploy-cloudflare.sh` lo genera y lo registra por ti.
JWT_SECRET=

# --- La app y tu servidor ---------------------------------------------------
# Origen de tu Worker. La app le añade `/api` por su cuenta.
# El script de despliegue escribe esta URL en `apps/minerva-app/.env.local`.
NEXT_PUBLIC_API_BASE_URL=https://minerva-cloudflare.<tu-subdominio>.workers.dev

# Cambia la capa de cuenta de Minerva Cloud a tu Worker: la app se registra
# con email + passphrase contra tu servidor y nunca habla con Supabase.
SELF_HOSTED_BACKEND=true
NEXT_PUBLIC_SELF_HOSTED_BACKEND=true

# Desbloquea las funciones de pago: en un despliegue propio no hay tienda y
# todas las funciones quedan disponibles.
SELF_HOSTED=true
NEXT_PUBLIC_SELF_HOSTED=true

# Passphrase de sincronizacion: cifra en el cliente los campos sensibles que
# se suben (contrasenas de catalogos, etc.). El servidor solo guarda la sal
# y el texto cifrado. Puedes dejar esta variable vacia y escribirla en
# Ajustes → Sincronización, pero entonces hay que teclearla en cada
# dispositivo.
SYNC_PASSPHRASE=

# --- Opcionales -------------------------------------------------------------
# Origenes del navegador autorizados a llamar a la API (lista separada por
# comas). `*` vale para un despliegue personal.
ALLOWED_ORIGINS=*

# Techo de subida por libro, en bytes. El limite de la plataforma son 100 MB.
MAX_UPLOAD_BYTES=104857600

# Cuota de almacenamiento por cuenta, en bytes. 0 = sin cuota.
STORAGE_FIXED_QUOTA=0

# Iteraciones del KDF (PBKDF2) con las que se derivan las passphrases. Bajarlo
# abarata el servidor y debilita la clave; el numero queda guardado con cada
# hash, asi que bajarlo nunca invalida las cuentas ya creadas.
PASSPHRASE_KDF_ITERATIONS=600000

# Telemetría (PostHog). Vacia = sin telemetría; la app funciona igual.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
