# Minerva — variables de entorno
#
# Copia este archivo a `apps/minerva-app/.env` (Next.js lo carga solo) y
# rellena lo que necesites. Este archivo contiene SOLO nombres de variables:
# ningun valor real se versiona.
#
# Los identificadores publicos del servicio alojado (Supabase, PostHog,
# Stripe) y las claves publicas de Pagebound vienen compilados en
# `apps/minerva-app/src/services/publicDefaults.ts`, asi que la aplicacion
# funciona sin ningun dotfile. Cualquier variable de este archivo tiene
# prioridad sobre ese valor por defecto.
#
# El stack autoalojado con Docker tiene su propia plantilla en
# `docker/.env.example`; el Worker de sincronizacion, en
# `apps/minerva-app/workers/minerva-sync/wrangler.toml`.

# --- Aplicacion -----------------------------------------------------------
# Plataforma de la build: `tauri` (escritorio y movil) o `web`.
NEXT_PUBLIC_APP_PLATFORM=
# Distribucion de la build: `stable`, `nightly`...
NEXT_PUBLIC_DIST_CHANNEL=
# Desactiva el actualizador integrado.
NEXT_PUBLIC_DISABLE_UPDATER=
# Marca la build como portable (sin instalador).
NEXT_PUBLIC_PORTABLE_APP=
# Diagnostico de paginas en el cliente.
NEXT_PUBLIC_PAGE_CURL_DIAGNOSTICS=
# URL base del backend de la API. La aplicacion anade `/api` por su cuenta.
NEXT_PUBLIC_API_BASE_URL=
# URL base del servicio Node de Minerva.
NEXT_PUBLIC_NODE_BASE_URL=

# --- Cuenta y sincronizacion ----------------------------------------------
# Proyecto Supabase propio. Si no se define, se usa el de Minerva Cloud.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: solo en el servidor, nunca en el navegador.
SUPABASE_ADMIN_KEY=
# Cuota de almacenamiento por usuario, en bytes (0 = sin cuota).
NEXT_PUBLIC_STORAGE_FIXED_QUOTA=
# Cuota diaria de traduccion por usuario.
NEXT_PUBLIC_TRANSLATION_FIXED_QUOTA=
# Backend autoalojado (Cloudflare Workers + D1 + R2). Ver docs/DEPLOYMENT.md.
SELF_HOSTED_BACKEND=
NEXT_PUBLIC_SELF_HOSTED_BACKEND=
# Desbloquea las funciones de pago en un despliegue autoalojado.
SELF_HOSTED=
NEXT_PUBLIC_SELF_HOSTED=

# --- Publicos del servicio alojado (valores por defecto compilados) ------
# Suelen dejarse vacios: sin ellos se usa el valor por defecto.
NEXT_PUBLIC_DEFAULT_SUPABASE_URL_BASE64=
NEXT_PUBLIC_DEFAULT_SUPABASE_KEY_BASE64=
NEXT_PUBLIC_DEFAULT_POSTHOG_URL_BASE64=
NEXT_PUBLIC_DEFAULT_POSTHOG_KEY_BASE64=

# --- Telemetria -----------------------------------------------------------
# Clave de proyecto de PostHog. Vacia = telemetria desactivada.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Pagos (Stripe) -------------------------------------------------------
# Clave publicable (la que va en el navegador), en base64.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_BASE64=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_DEV_BASE64=
# Clave secreta y secreto del webhook: solo en el servidor.
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_DEV=
STRIPE_WEBHOOK_SECRET=

# --- Traduccion -----------------------------------------------------------
# Claves de DeepL, separadas por coma. Vacias = sin traduccion.
DEEPL_PRO_API_KEYS=
DEEPL_FREE_API_KEYS=
# Huella de cliente de DeepL para las claves gratuitas.
DEEPL_X_FINGERPRINT=
# Claves de la API de Google Books.
GOOGLE_BOOKS_API_KEYS=

# --- Almacenamiento de archivos --------------------------------------------
# `r2` o `s3`.
NEXT_PUBLIC_OBJECT_STORAGE_TYPE=
R2_TOKEN_VALUE=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_REGION=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=
# Bucket publico para las portadas y archivos compartidos.
TEMP_STORAGE_PUBLIC_BUCKET_NAME=
# Directorio de las fuentes CJK que sirve el lector.
FONT_BASE_URL=
NEXT_PUBLIC_FONT_BASE_URL=

# --- Voz y catalogo --------------------------------------------------------
# Catalogo de TTS en linea.
MINERVA_TTS_CATALOG_URL=
# Cuota diaria de caracteres de TTS, por plan (0 = sin cuota).
TTS_FIXED_QUOTA=

# --- Integraciones --------------------------------------------------------
# Pagebound: clave de cliente de Firebase y clave de solo busqueda de
# Typesense. Son claves publicas de un tercero; restricts por dominio en su
# panel. Vacias = integracion desactivada.
NEXT_PUBLIC_PAGEBOUND_FIREBASE_API_KEY=
NEXT_PUBLIC_PAGEBOUND_TYPESENSE_API_KEY=
# WordLens: diccionario y CDN.
WORDLENS_R2_BUCKET=
WORDLENS_CDN_BASE=

# --- Inicio de sesion con terceros (OAuth) ---------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_USE_APPLE_SIGN_IN=
# Apple: credenciales de la firma de in-app purchases (solo servidor).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_KEY_PATH=
APPLE_SERVICES_ID=
APPLE_IAP_BUNDLE_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY_BASE64=
APPLE_SECRET_DAYS=

# --- Verificacion de compras en Google Play (solo servidor) ---------------
GOOGLE_IAP_PACKAGE_NAME=
GOOGLE_IAP_SERVICE_ACCOUNT_KEY=
GOOGLE_RTDN_VERIFICATION_TOKEN=
